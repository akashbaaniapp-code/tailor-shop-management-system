# ===== Tailor Shop MS — Environment Variables =====

# Database (Turso / libSQL)
# Get these from https://turso.tech app > your database > Settings
DATABASE_URL=libsql://your-db-name-your-org.turso.io
DATABASE_AUTH_TOKEN=eyJhbGciOi...your-turso-token...

# Auth
# Generate a strong random string (e.g. from https://generate-secret.vercel.app)
JWT_SECRET=change-this-to-a-long-random-string

# (Optional) For local SQLite dev only — comment out the Turso vars above and use:
# DATABASE_URL=file:./db/custom.db
